# Copy to .env and adjust. All values override config/settings.yaml.
# Nested settings use double-underscore: REGFLOW_<SECTION>__<FIELD>.

REGFLOW_ENVIRONMENT=dev
REGFLOW_LOG_LEVEL=INFO
REGFLOW_LOG_FORMAT=console

# When running the app outside docker but services inside docker, keep localhost.
# When running the app inside docker-compose, use service names:
#   REGFLOW_POSTGRES__HOST=postgres
#   REGFLOW_NEO4J__URI=bolt://neo4j:7687
#   REGFLOW_WEAVIATE__HOST=weaviate
#   REGFLOW_MINIO__ENDPOINT=minio:9000
#   REGFLOW_LLM__BASE_URL=http://ollama:11434

# Rented-GPU vLLM example (OpenAI-compatible endpoint):
#   REGFLOW_LLM__PROVIDER=vllm
#   REGFLOW_LLM__BASE_URL=http://<gpu-host>:8000/v1
#   REGFLOW_LLM__EXTRACTION_MODEL=meta-llama/Llama-3.1-8B-Instruct
